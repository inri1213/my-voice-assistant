// Путь к приложениям на вашем компьютере (Windows)
const telegramPath = "C:/Users/имя_пользователя/AppData/Roaming/Telegram Desktop/Telegram.exe";
const vkMusicPath = "C:/Program Files/VK/VKMusic/vkmusic.exe"; // Или путь до ярлыка
const yandexBrowserPath = "C:/Program Files/Yandex/YandexBrowser/application/browser.exe";

// API-ключи для работы с внешними сервисами
const weatherApiKey = 'YOUR_API_KEY'; // Получите бесплатно здесь: https://openweathermap.org/api
const wikiApiUrl = 'https://en.wikipedia.org/w/api.php';

// Настройки голоса (изменяйте по желанию)
let voiceName = 'Microsoft Irina Desktop - Russian'; // Имя голосового движка
let speechRate = 1; // Скорость речи (от 0.1 до 10)
let speechPitch = 1; // Тембр (от 0 до 2)

// Инициализация синтеза речи
function speak(text) {
    const synth = window.speechSynthesis;
    if (!synth.getVoices().length) return false;
    
    let voices = synth.getVoices();
    let selectedVoice = voices.find(v => v.name === voiceName);

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.voice = selectedVoice || voices[0];
    utterance.rate = speechRate;
    utterance.pitch = speechPitch;

    synth.speak(utterance);
}

// Функция распознавания речи
async function recognizeSpeech() {
    try {
        const recognition = new webkitSpeechRecognition(); // Используем веб-версию
        recognition.lang = 'ru-RU';
        
        // Показываем статус
        document.querySelector('.speech-bubble').innerText = 'Говорите...';
        document.body.classList.add('listening');

        recognition.start();

        recognition.onresult = async event => {
            const command = event.results[0][0].transcript.trim().toLowerCase();
            await handleCommand(command); // Отправляем команду на обработку
        };

        recognition.onend = () => {
            document.body.classList.remove('listening'); // Снимаем класс прослушки
        };
    } catch (e) {
        console.error(e);
        alert('Ошибка микрофона. Проверьте настройки браузера.');
    }
}

