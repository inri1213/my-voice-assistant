function handleCommand(command) {
    switch(true) {
        // ... здесь другие команды ...

        // Универсальное приветствие (любая фраза со словом "привет" или синонимами)
        case /(привет|здравствуй|добрый(.*)?день|здравствуйте)/i.test(command): 
            speak("Приветствую вас!");
            break;

        // Или оставляем старую команду как вариант:
        // case /^(как дела|как поживаешь)/i.test(command):
        //     speak("У меня всё отлично! Готов помочь вам.");
        //     break;
        
        // ... остальные команды ...

        case /^(как дела|как поживаешь)/i.test(command):
            speak("У меня всё отлично! Готов помочь вам.");
            break;

        case /(спасибо|благодарю)/i.test(command):
            speak("Всегда пожалуйста!");
            break;

        case /^(до свидания|пока|всего хорошего)/i.test(command):
            speak("До встречи! Хорошего дня.");
            break;

        // Комплименты
        case /бот/i.test(command):
            speak("Спасибо за добрые слова! Я всего лишь программа, но стараюсь быть полезной.");
            break;

        case /самый лучший/i.test(command):
            speak("Вы очень добры! Но я просто ваш верный помощник.");
            break;

        // Работа с датой и временем
        case /^(сколько времени|который час)/i.test(command):
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            speak(`Сейчас ${hours}:${minutes}`);
            break;

        case /^(какая дата|сегодня какой день)/i.test(command):
            const today = new Intl.DateTimeFormat('ru', { dateStyle: 'full' }).format(new Date());
            speak(today);
            break;

        // Погода (нужно получить свой ключ выше!)
        case /погода/i.test(command):
            if (!weatherApiKey) {
                speak('Не могу проверить погоду без ключа OpenWeatherMap.');
                return;
            }

            const city = 'Москва'; // Можно менять город
            const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&lang=ru&appid=${weatherApiKey}`;
            
            const response = await fetch(url);
            const data = await response.json();

            if (data.cod !== 200) {
                speak('К сожалению, возникли проблемы при получении данных о погоде.');
                return;
            }

            const temp = Math.round(data.main.temp);
            const description = data.weather[0].description;
            speak(`В ${city} сейчас ${temp} градусов Цельсия, ${description}.`);
            break;

        // Случайная шутка (на английском)
        case /шутка/i.test(command):
            const jokeResponse = await fetch('https://official-joke-api.appspot.com/jokes/random');
            const joke = await jokeResponse.json();
            speak(joke.setup + '. ' + joke.punchline);
            break;

        // Случайный факт из Википедии (на английском)
        case /факт/i.test(command):
            const params = new URLSearchParams({
                action: 'query',
                format: 'json',
                generator: 'random',
                grnnamespace: 0,
                prop: 'extracts',
                exintro: true,
                exhplaintext: true,
                origin: '*'
            });

            const factResponse = await fetch(`${wikiApiUrl}?${params}`);
            const factData = await factResponse.json();
            const extract = factData?.query?.pages[Object.keys(factData.query.pages)[0]]?.extract;

            if (extract) {
                speak(extract.split('\n')[0]); // Читаем только первое предложение
            } else {
                speak('Ой, что-то пошло не так. Попробуйте ещё раз!');
            }
            break;

        // Сайты
        case /открыть ютуб|youtube/i.test(command):
            window.open("https://www.youtube.com");
            speak("Запускаю YouTube");
            break;

        case /открыть вк|вконтакте/i.test(command):
            window.open("https://vk.com");
            speak("Открываю ВКонтакте");
            break;

        case /музыка|ютуб музыка/i.test(command):
            window.open("https://music.youtube.com");
            speak("Открываю YouTube Music");
            break;

        case /яндекс музыка/i.test(command):
            window.open("https://music.yandex.ru/home");
            speak("Открываю Яндекс Музыку");
            break;

        case /телеграм/i.test(command):
            window.open("https://web.telegram.org/k/");
            speak("Открываю Телеграм Веб");
            break;

        case /нетфликс/i.test(command):
            window.open("https://netflix.com");
            speak("Открываю Нетфликс");
            break;

        case /спотифай/i.test(command):
            window.open("https://open.spotify.com");
            speak("Открываю Спотифай");
            break;

        // Приложения (запускаются только на ПК, где открыт сайт)
        case /открой телеграм/i.test(command):
            require('child_process').execFile(telegramPath);
            speak("Запускаю Телеграм");
            break;

        case /открой vk музыку/i.test(command):
            require('child_process').execFile(vkMusicPath);
            speak("Запускаю VK Музыку");
            break;

        case /открой браузер/i.test(command):
            require('child_process').execFile(yandexBrowserPath);
            speak("Запускаю Яндекс.Браузер");
            break;

        default:
            speak('Извините, команда не распознанa.');
    }
}

document.querySelector('#start-btn').addEventListener('click', recognizeSpeech);
